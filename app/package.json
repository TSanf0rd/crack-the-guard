{
  "name": "crack-the-guard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && SINGLE=1 vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "publish": "npm run build:single && cp dist-single/index.html ../index.html",
    "test:phrasings": "rolldown tests/phrasings.ts -o node_modules/.cache/phrasings.mjs --platform node && node node_modules/.cache/phrasings.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
